[Unit]
Description=SeismicPi – guardiano Wi-Fi con Access Point di emergenza
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=seismic
Group=seismic
SupplementaryGroups=netdev
WorkingDirectory=/opt/seismicpi
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m seismicpi.netwatch
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
